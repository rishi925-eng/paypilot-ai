# ==========================================
# PayPilot AI Environment Configuration
# ==========================================

# Server Ports
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paypilot_db?schema=public"

# PayPal Sandbox Credentials
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# AI & LLM Provider Configuration
# Supported providers: "ollama" | "mock" | "openai-compatible"
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security & Session
SESSION_SECRET=super_secret_session_key_replace_in_production_min_32_chars
ADMIN_API_KEY=paypilot_admin_secret_key_123
